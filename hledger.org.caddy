# SUBDOMAINS

# shortcut urls

# code repo
code.hledger.org {
	redir https://github.com/hledgerorg/hledger
}
# site repo
site.hledger.org {
	redir https://github.com/hledgerorg/hledger_site
}
# finance repo
finance.hledger.org {
	redir https://github.com/hledgerorg/hledger_finance
}
# github projects
projects.hledger.org {
	redir https://github.com/hledgerorg/hledger/projects
}
# mail list
mail.hledger.org list.hledger.org {
	redir https://groups.google.com/group/hledger
}
# irc channel
irc.hledger.org {
	redir https://web.libera.chat/#hledger
}
# matrix access to irc channel, any client
matrix.hledger.org {
	redir "https://matrix.to/#/#hledger:matrix.org"
}
# hledger enhancement proposals/hledger improvement proposals
hep.hledger.org hip.hledger.org {
	redir https://github.com/hledgerorg/hledger/issues/462
}
release.hledger.org {
	redir https://github.com/hledgerorg/hledger/releases/latest
}
nightly.hledger.org {
	redir https://github.com/hledgerorg/hledger/releases/nightly
}
issues.hledger.org {
	# all open issues
	redir / https://github.com/hledgerorg/hledger/issues
	# the ISSUES page: https://hledger.org/ISSUES.html
	# new generic issue form
	redir /new https://github.com/hledgerorg/hledger/issues/new
}
bugs.hledger.org {
	# all bugs
	redir / "https://github.com/hledgerorg/hledger/issues?q=is:issue+label:A-BUG"
	# all regression bugs
	redir /regressions https://github.com/hledgerorg/hledger/issues?q=label:regression
	# new bug form
	redir /new https://github.com/hledgerorg/hledger/issues/new?labels=A=BUG&template=a-bug.md
	# TODO:
	# bugs.hledger.org/N
}

# # all issues and PRs
# issues.hledger.org {
# }
# open wishlist issues
wishes.hledger.org {
	redir "https://github.com/hledgerorg/hledger/issues?q=is:issue+is:open+label:A-WISH"
}
regressions.hledger.org {
	redir "https://hledger.org/REGRESSIONS.html"
}
# open pull requests
prs.hledger.org {
	redir https://github.com/hledgerorg/hledger/pulls?q=is:open
}
# draft open pull requests
draftprs.hledger.org {
	redir https://github.com/hledgerorg/hledger/pulls?q=is:open+is%3Adraft
}
# ready open pull requests - not marked draft by contributor, not labelled needs-* by maintainer
readyprs.hledger.org {
	redir https://github.com/hledgerorg/hledger/pulls?q=is:open+-is:draft+-label:needs-changes+-label:needs-clarification+-label:needs-code+-label:needs-debugging+-label:needs-design+-label:needs-discussion+-label:needs-docs+-label:needs-history-cleanup+-label:needs-impact-analysis+-label:needs-mockup/screenshot+-label:needs-other-task+-label:needs-rebase+-label:needs-repro+-label:needs-research+-label:needs-review+-label:needs-testing+-label:needs-tests+-label:needs-value-proposition
}
assignedprs.hledger.org {
	redir https://github.com/hledgerorg/hledger/pulls?q=is%3Aopen+assignee%3A*
}
unassignedprs.hledger.org {
	redir https://github.com/hledgerorg/hledger/pulls?q=is%3Aopen+no%3Aassignee
}
