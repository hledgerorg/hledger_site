waffle.hledger.org {
	redir https://waffle.io/hledgerorg/hledger?source=simonmichael%2Fhledger
}
stars.hledger.org {
	redir https://hledger.org/ACHIEVEMENTS.html#stars
}
wiki.hledger.org {
	redir https://github.com/hledgerorg/hledger/wiki
}
comments.hledger.org {
	reverse_proxy localhost:8042
}
demo.hledger.org {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	log {
		output file /var/log/caddy/demo.hledger.org.log
		# format single_field common_log
		format transform "{common_log}"
		# log in local time zone - requires caddy 2.6.3+
		# format transform "{common_log}" {
		# 	time_format "02/Jan/2006:15:04:05 -0700"  # ?
		# 	time_zone   local
		# }
	}
	handle / {
		redir https://demo.hledger.org/register?q=inacct%3AAssets%3AUS%3ABofA%3AChecking%20
	}
	handle {
		reverse_proxy localhost:5000
	}
}
demo1.hledger.org {
	reverse_proxy localhost:5001
}
hooks.hledger.org {
	reverse_proxy localhost:8888
}

